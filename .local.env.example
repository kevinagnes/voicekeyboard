# Local-only environment overrides for the release pipeline (gitignored).
# Copy this file to .local.env and fill in values.

# GitHub token with `contents:write` scope (repo: create releases). If unset,
# gh falls back to `gh auth login` credentials.
#GH_TOKEN=ghp_xxxxxxxxxxxx

# Notarization (optional — overrides the stored keychain profile):
#VK_APPLE_ID=your@apple.id
#VK_NOTARY_PASSWORD=xxxx-xxxx-xxxx-xxxx
#VK_TEAM_ID=2JNC7VSQ8N
